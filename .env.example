# ============================================================
# Steer — environment. Copy to `.env` and fill in the blanks.
# `docker compose up` reads this file automatically.
# ============================================================

# --- Database ---------------------------------------------------------------
# Defaults to the local Postgres container. To use a hosted Neon database
# instead, set DATABASE_URL to your Neon connection string (keep its own
# ?sslmode=require). Neon is OPTIONAL — the container works out of the box.
POSTGRES_USER=steer
POSTGRES_PASSWORD=steer
POSTGRES_DB=steer
DATABASE_URL=postgresql://steer:steer@postgres:5432/steer?sslmode=disable

# --- Electric sync (internal; the server proxies to it) ---------------------
ELECTRIC_URL=http://electric:3000

# --- WorkOS AuthKit ---------------------------------------------------------
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# Exposed to the browser (public, safe):
VITE_WORKOS_CLIENT_ID=
VITE_WORKOS_REDIRECT_URI=http://localhost:5173/callback

# --- Browser → server origin ------------------------------------------------
VITE_SERVER_URL=http://localhost:8080

# --- LLM provider (the coding agent) ----------------------------------------
# Set ONE provider's key. The agent auto-detects the provider (OpenAI preferred
# when both are present), or pin it explicitly with LLM_PROVIDER=openai|anthropic.
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional model override (otherwise a sensible default per provider is used):
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# --- Agent runtime ----------------------------------------------------------
# The coding agent operates on the directory it runs in (read_file/list_dir/bash/
# write_file act on real files there). Override to point it at a specific project
# (e.g. a volume you mount into the agent container):
# STEER_WORKSPACE_ROOT=/workspace
# Safety ceiling on steps before a run is force-stopped (default 40):
# STEER_MAX_STEPS=40
