# ============================================================
# Steer — environment. Copy to `.env` and fill in the blanks.
# `docker compose up` reads this file automatically.
# ============================================================

# --- Database ---------------------------------------------------------------
# Defaults to the local Postgres container. To use a hosted Neon database
# instead, set DATABASE_URL to your Neon connection string (keep its own
# ?sslmode=require). Neon is OPTIONAL — the container works out of the box.
POSTGRES_USER=steer
POSTGRES_PASSWORD=steer
POSTGRES_DB=steer
DATABASE_URL=postgresql://steer:steer@postgres:5432/steer?sslmode=disable

# --- Electric sync (internal; the server proxies to it) ---------------------
ELECTRIC_URL=http://electric:3000

# --- WorkOS AuthKit ---------------------------------------------------------
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# Exposed to the browser (public, safe):
VITE_WORKOS_CLIENT_ID=
VITE_WORKOS_REDIRECT_URI=http://localhost:5173/callback

# --- Browser → server origin ------------------------------------------------
VITE_SERVER_URL=http://localhost:8080

# --- LLM provider (the coding agent) ----------------------------------------
ANTHROPIC_API_KEY=
