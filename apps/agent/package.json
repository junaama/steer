{
  "name": "@steer/agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "DATABASE_URL=${DATABASE_URL:-postgresql://steer:steer@localhost:54321/steer?sslmode=disable} ELECTRIC_URL=${ELECTRIC_URL:-http://localhost:3000} tsx watch --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local src/index.ts",
    "serve": "tsx src/index.ts",
    "agent": "DATABASE_URL=${DATABASE_URL:-postgresql://steer:steer@localhost:54321/steer?sslmode=disable} ELECTRIC_URL=${ELECTRIC_URL:-http://localhost:3000} tsx --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local src/bin-agent.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@steer/schema": "workspace:*",
    "@ai-sdk/anthropic": "^1.0.6",
    "@ai-sdk/openai": "^1.0.11",
    "@electric-sql/client": "^1.5.20",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ai": "^4.0.30",
    "drizzle-orm": "^0.38.3",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "@vitest/coverage-v8": "^2.1.8",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10"
  }
}
