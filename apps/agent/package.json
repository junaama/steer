{
  "name": "@steer/agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "DATABASE_URL=${DATABASE_URL:-postgresql://steer:steer@localhost:54321/steer?sslmode=disable} ELECTRIC_URL=${ELECTRIC_URL:-http://localhost:3000} tsx watch --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local src/index.ts",
    "serve": "tsx src/index.ts",
    "agent": "DATABASE_URL=${DATABASE_URL:-postgresql://steer:steer@localhost:54321/steer?sslmode=disable} ELECTRIC_URL=${ELECTRIC_URL:-http://localhost:3000} tsx --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local src/bin-agent.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "eval": "DATABASE_URL=${EVAL_DATABASE_URL:-${DATABASE_URL:-postgresql://steer:steer@localhost:54321/steer?sslmode=disable}} tsx --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local evals/run.ts",
    "eval:bench": "EVAL_DATABASE_URL=${EVAL_DATABASE_URL:-postgresql://steer:steer@localhost:54321/steer_eval?sslmode=disable} tsx --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local evals/benchmarks/run.ts",
    "eval:history": "DATABASE_URL=${EVAL_DATABASE_URL:-postgresql://steer:steer@localhost:54321/steer_eval?sslmode=disable} tsx --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local evals/run-conversation.ts",
    "eval:typecheck": "tsc -p tsconfig.evals.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.81",
    "@ai-sdk/openai": "^2.0.106",
    "@electric-sql/client": "^1.5.20",
    "@langfuse/otel": "^5.4.1",
    "@langfuse/tracing": "^5.4.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@steer/schema": "workspace:*",
    "ai": "^5.0.197",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@langfuse/client": "^5.4.1",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "^2.1.8",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
