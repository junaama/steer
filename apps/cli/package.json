{
  "name": "@steer/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "steer": "dist/main.js"
  },
  "scripts": {
    "steer": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json --noEmit false",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "@vitest/coverage-v8": "^2.1.8",
    "@types/node": "^22.10.5"
  }
}
