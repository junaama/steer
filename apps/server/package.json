{
  "name": "@steer/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "DATABASE_URL=${DATABASE_URL:-postgresql://steer:steer@localhost:54321/steer?sslmode=disable} ELECTRIC_URL=${ELECTRIC_URL:-http://localhost:3000} tsx watch --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local src/index.ts",
    "serve": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "migrate": "tsx src/migrate.ts",
    "migrate:local": "DATABASE_URL=${DATABASE_URL:-postgresql://steer:steer@localhost:54321/steer?sslmode=disable} tsx --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@steer/schema": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.2.1",
    "jose": "^5.9.6",
    "pg": "^8.13.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "^2.1.8",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
