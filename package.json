{
  "name": "steer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.6.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:coverage": "pnpm -r --workspace-concurrency=1 test:coverage",
    "migrate": "pnpm --filter @steer/server migrate",
    "seed": "pnpm --filter @steer/server seed",
    "steer": "pnpm --filter @steer/cli steer",
    "up": "docker compose $([ -f .env.local ] && echo --env-file .env.local) up --build"
  }
}
